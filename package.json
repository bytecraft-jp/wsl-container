{
  "name": "wsl-container-studio",
  "productName": "WSL Container Studio",
  "version": "0.1.0",
  "description": "WSL3 の wslc コンテナーを GUI で管理するデスクトップアプリ",
  "main": "electron/main.cjs",
  "type": "module",
  "author": "t.shigei",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "vite build && node scripts/dev.mjs --prod",
    "test": "node --test test/*.test.cjs",
    "icon": "node scripts/generate-icon.mjs",
    "dist": "vite build && electron-builder --win"
  },
  "build": {
    "appId": "jp.bytecraft.wsl-container-studio",
    "productName": "WSL Container Studio",
    "extraResources": [
      {
        "from": "electron/assets/icon.ico",
        "to": "assets/icon.ico"
      }
    ],
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "asarUnpack": [
      "electron/storage/*.ps1"
    ],
    "win": {
      "icon": "electron/assets/icon.ico",
      "target": [
        "portable"
      ]
    },
    "directories": {
      "output": "release"
    }
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.13",
    "@lucide/vue": "^1.49.0",
    "@lydell/node-pty": "^1.2.0-beta.15",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.16",
    "marked": "^18.0.14",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.9",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "vite": "^8.3.1"
  }
}
